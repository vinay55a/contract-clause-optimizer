{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "startCommand": "serve -s dist -l $PORT",
    "numReplicas": 1,
    "restartPolicyType": "always",
    "healthCheck": {
      "path": "/",
      "interval": 30,
      "timeout": 5
    }
  },
  "env": {
    "VITE_API_URL": "https://contract-clause-optimizer.onrender.com"
  }
}

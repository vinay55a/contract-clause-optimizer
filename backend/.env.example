# =============================================================
# Contract Clause Optimizer — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---- Application ----
APP_ENV=development
SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Database ----
# SQLite (default for local dev — no setup needed)
DATABASE_URL=sqlite:///./contract_optimizer.db
# PostgreSQL (for production / Docker)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/contract_optimizer

# ---- Gemini AI ----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
# Set to "true" to use mock AI responses (no API key needed)
USE_MOCK_AI=true

# ---- File Upload ----
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# ---- CORS ----
FRONTEND_URL=http://localhost:5173

# ---- Export ----
EXPORT_DIR=exports
